# Jan Sahayak Backend Environment Configuration
# Copy this file to .env in this directory and replace the placeholder values.

# Google Gemini API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-2.5-flash (fast, accurate, cost-effective)
GEMINI_MODEL=gemini-2.5-flash

# Allowed Frontend Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Port (changed from 8000 to 8005 to avoid port collision)
PORT=8005
